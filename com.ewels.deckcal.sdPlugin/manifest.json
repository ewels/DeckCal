{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "DeckCal",
  "Version": "1.0.0.0",
  "Author": "Phil Ewels",
  "URL": "https://deckcal.ewels.co.uk/",
  "SupportURL": "https://github.com/ewels/deckcal/issues",
  "Actions": [
    {
      "Name": "Meeting countdown",
      "UUID": "com.ewels.deckcal.countdown",
      "Icon": "imgs/actions/countdown/icon",
      "Tooltip": "Live countdown to your next Google Calendar meeting. Set it to show the meeting you are in, the next one, or whichever is most relevant.",
      "PropertyInspectorPath": "ui/countdown.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/countdown/key",
          "TitleAlignment": "middle",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Upcoming meeting (retired)",
      "UUID": "com.ewels.deckcal.upcoming",
      "Icon": "imgs/actions/upcoming/icon",
      "Tooltip": "Retired: use Meeting countdown and set Show to \"Next meeting only\".",
      "VisibleInActionsList": false,
      "PropertyInspectorPath": "ui/countdown.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/upcoming/key",
          "TitleAlignment": "middle",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Ongoing meeting (retired)",
      "UUID": "com.ewels.deckcal.ongoing",
      "Icon": "imgs/actions/ongoing/icon",
      "Tooltip": "Retired: use Meeting countdown and set Show to \"Current meeting only\".",
      "VisibleInActionsList": false,
      "PropertyInspectorPath": "ui/countdown.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/ongoing/key",
          "TitleAlignment": "middle",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Meeting alert",
      "UUID": "com.ewels.deckcal.alert",
      "Icon": "imgs/actions/alert/icon",
      "Tooltip": "Bare tile: no text, just the yellow fill before a meeting, the green bar during it, and a flash as it starts. Place next to a countdown key for a wider bar.",
      "PropertyInspectorPath": "ui/countdown.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/alert/key",
          "TitleAlignment": "middle",
          "ShowTitle": false
        }
      ]
    }
  ],
  "Category": "DeckCal",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.js",
  "Description": "Live countdown to your next Google Calendar meeting, sweeping across as many keys as you give it.",
  "Icon": "imgs/plugin/marketplace",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "UUID": "com.ewels.deckcal"
}
