# Copy this file to .env.local and fill in the values. `.env.local` is
# gitignored — never commit it.
#
# Both values come from the Google Cloud Console "Credentials" page for the
# Desktop OAuth client you create for this plugin. See README for the full
# walkthrough. The client_secret is bundled into the released binary, which
# is fine for a Desktop OAuth client (RFC 8252) — anyone with the binary can
# extract it. PKCE provides the actual security.

DECKCAL_GOOGLE_CLIENT_ID=
DECKCAL_GOOGLE_CLIENT_SECRET=
